<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Target framework version (.NET 10). Defines the runtime and APIs available -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Enables C# 8.0+ nullable reference types to enforce compile-time null safety -->
    <Nullable>enable</Nullable>
    <!-- Automatically imports common global namespaces (e.g., System, System.Linq, Microsoft.AspNetCore.Http) -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet package reference required for endpoints metadata and OpenAPI/Swagger documentation generation -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />

    <!-- 
      Required tooling package for Entity Framework Core CLI (dotnet-ef).
      It enables design-time tasks such as generating database migrations and compiling models.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <!-- 
        IncludeAssets: Specifies which assets from the NuGet package to consume.
        Includes build tools, native binaries, and analyzer logic required at compile time.
      -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      
      <!-- 
        PrivateAssets="all": Prevents this dependency from leaking/transmitting to referenced projects.
        It marks the package as internal tooling for this project only, keeping downstream modules clean.
      -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Ecommerce.Shared.csproj" />

    <!-- Ecommerce.Module.Infrastructure.csproj
      Project reference required to scan module Fluent API configurations and register services -->
    
    <!-- Ecommerce.Module.Application.csproj
      Application reference for Services and DTOs -->
    
    <!-- Ecommerce.Module.API.csproj
      API reference for Controllers -->

    <!-- Products Module -->
    <ProjectReference Include="..\Modules\Products\API\Ecommerce.Products.API.csproj" />
    <ProjectReference Include="..\Modules\Products\Application\Ecommerce.Products.Application.csproj" />
    <ProjectReference Include="..\Modules\Products\Infrastructure\Ecommerce.Products.Infrastructure.csproj" />
  </ItemGroup>

</Project>